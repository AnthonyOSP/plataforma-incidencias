@model IEnumerable<Incidencia>
@{
    ViewData["Title"] = "Incidencias abiertas";
    var esSupervisor = User.IsInRole(PlataformaIncidencias.Data.Roles.Supervisor);
}

<h1>Incidencias abiertas en tiempo real</h1>

<p id="estado-tiempo-real" class="small text-muted"
   data-ws-url="@ViewData["PieHostWebSocketUrl"]"
   data-sync-url="@Url.Action("IncidenciasAbiertas", "Operaciones")">
    Tiempo real: desconectado
</p>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success" role="alert">@mensaje</div>
}

@if (!Model.Any())
{
    <p id="sin-incidencias" class="text-muted">No hay incidencias abiertas.</p>
}
else
{
    <table id="tabla-incidencias" class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>ID</th>
                <th>Estación</th>
                <th>Descripción</th>
                <th>Prioridad</th>
                <th>Estado</th>
                <th>Fecha de creación</th>
                <th>Acción</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var incidencia in Model)
            {
                var claseBadge = incidencia.Prioridad switch
                {
                    Prioridad.Critica => "bg-danger",
                    Prioridad.Alta => "bg-warning text-dark",
                    Prioridad.Media => "bg-info text-dark",
                    _ => "bg-secondary"
                };
                <tr data-incidencia-id="@incidencia.Id">
                    <td>@incidencia.Id</td>
                    <td>@incidencia.Estacion</td>
                    <td>@incidencia.Descripcion</td>
                    <td><span class="badge @claseBadge">@incidencia.Prioridad</span></td>
                    <td data-campo="estado">@incidencia.Estado</td>
                    <td>@incidencia.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        @if (esSupervisor)
                        {
                            <form asp-action="Cerrar" asp-route-id="@incidencia.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Cerrar</button>
                            </form>
                        }
                        else
                        {
                            <span class="text-muted small">Solo Supervisor</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@section Scripts {
    <script src="~/js/incidencias-tiempo-real.js" asp-append-version="true"></script>
}
